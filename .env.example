# =============================================================================
# Copy this file to .env and fill in real values for LOCAL development only.
# Never commit .env — it's in .gitignore.
# In GitHub Actions, these live as Repository Secrets (Settings → Secrets and
# variables → Actions), NOT in .env. Do not put real values in this file.
# =============================================================================

# --- Slack -------------------------------------------------------------------
# User OAuth Token from your Slack app. Starts with xoxp-
# App scopes required: groups:history, groups:read, files:read, chat:write
SLACK_USER_TOKEN=xoxp-YOUR-TOKEN-HERE

# Channel ID (not name). Get it from Slack: click the channel name → About →
# scroll to bottom → "Channel ID"
SLACK_CHANNEL_ID=C0A84HY8B41

# --- Google Drive -----------------------------------------------------------
# The Drive folder where daily reports will be uploaded.
# From the folder URL: https://drive.google.com/drive/folders/{THIS-PART}
GDRIVE_FOLDER_ID=your-drive-folder-id-here

# Google service account credentials JSON.
# For LOCAL dev: full JSON as a single-line string (or a file path via
#   GOOGLE_APPLICATION_CREDENTIALS pointing to a downloaded .json file)
# For GITHUB ACTIONS: paste the full JSON content into the secret named
#   GOOGLE_APPLICATION_CREDENTIALS_JSON. Multiline pastes work fine.
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
